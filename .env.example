# Environment Configuration for VisionGuard (23L-0994_A2_Ops)
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Model Configuration
MODEL_PATH=models/champion_model.keras
DECISION_THRESHOLD=0.50

# Database Configuration
DATABASE_URL=sqlite:///visionguard.db

# DagsHub & MLflow Tracking (Task 3 & Remote Tracking)
MLFLOW_TRACKING_URI=https://dagshub.com/shaheer/23L-0994_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=shaheer
MLFLOW_TRACKING_PASSWORD=your_dagshub_token_here

# Cloud API Integration (Task 7 & 8)
CLOUD_API_URL=https://shaheer-visionguard-api.hf.space/predict
USE_CLOUD_API=false
